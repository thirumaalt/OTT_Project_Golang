# EKS INGRESS — AWS Application Load Balancer (ALB)
#
# DIFFERENCE FROM KIND:
#   kind    → ingressClassName: nginx  (nginx ingress controller)
#   EKS     → ingressClassName: alb    (AWS Load Balancer Controller)
#
# WHAT IS ALB INGRESS CONTROLLER?
#   - Installed on EKS via Helm
#   - Reads Ingress resources and creates real AWS ALBs
#   - ALB is a managed AWS load balancer — no need to manage nginx yourself
#
# ANNOTATIONS EXPLAINED:
#   kubernetes.io/ingress.class: alb
#     → tells AWS LB controller to handle this ingress
#
#   alb.ingress.kubernetes.io/scheme: internet-facing
#     → ALB is public (internet-facing) or internal (private VPC only)
#     → internet-facing = users can access from browser
#
#   alb.ingress.kubernetes.io/target-type: ip
#     → route traffic directly to pod IP (faster, skips kube-proxy)
#     → alternative is "instance" which routes to node first
#
#   alb.ingress.kubernetes.io/certificate-arn: arn:aws:acm:...
#     → attach SSL certificate from AWS Certificate Manager
#     → on kind we don't have HTTPS, on EKS we get free SSL via ACM
#
#   alb.ingress.kubernetes.io/listen-ports: '[{"HTTP":80},{"HTTPS":443}]'
#     → ALB listens on both HTTP and HTTPS
#
#   alb.ingress.kubernetes.io/ssl-redirect: '443'
#     → automatically redirect HTTP → HTTPS
#
# TRAFFIC FLOW ON EKS:
#   Browser → ALB (AWS managed) → pod IP directly
#
# TRAFFIC FLOW ON KIND:
#   Browser → nginx ingress controller → service → pod

apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: myflix-ingress
  namespace: myflix
  annotations:
    kubernetes.io/ingress.class: alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    # Replace with your ACM certificate ARN after creating it in AWS
    # alb.ingress.kubernetes.io/certificate-arn: arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERT_ID
    # alb.ingress.kubernetes.io/listen-ports: '[{"HTTP":80},{"HTTPS":443}]'
    # alb.ingress.kubernetes.io/ssl-redirect: '443'
    alb.ingress.kubernetes.io/proxy-body-size: "2048m"
    alb.ingress.kubernetes.io/proxy-read-timeout: "300"
spec:
  ingressClassName: alb
  rules:
    - host: myflix.yourdomain.com   # replace with your domain
      http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: api-gateway
                port:
                  number: 8094
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend
                port:
                  number: 80
---
# FARO INGRESS — separate because of rewrite-target annotation
# Same reason as kind — rewrite applies to all paths in one ingress
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: faro-ingress
  namespace: myflix
  annotations:
    kubernetes.io/ingress.class: alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/actions.rewrite-collect: |
      {"type":"redirect","redirectConfig":{"path":"/collect","statusCode":"HTTP_301"}}
spec:
  ingressClassName: alb
  rules:
    - host: myflix.yourdomain.com
      http:
        paths:
          - path: /faro/collect
            pathType: Exact
            backend:
              service:
                name: alloy
                port:
                  number: 12347
